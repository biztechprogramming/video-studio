# Copied from the sibling oauth-demo-recorder project so this one works out of the box.
OPENAI_API_KEY=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Script writing + voice.
OPENAI_SCRIPT_MODEL=gpt-5.6-luna
# gpt-4o-mini-tts takes delivery direction, which is what lets each project act
# rather than just sound different. tts-1-hd still works and silently ignores it.
OPENAI_TTS_MODEL=gpt-4o-mini-tts
# The host's voice. Every project is cast against it: `video-studio voices`.
OPENAI_TTS_VOICE=ash

# Optional: raises the GitHub API rate limit. Left unset, the sources fall back to `gh auth token`.
# GITHUB_TOKEN=
