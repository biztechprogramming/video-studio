# Copied from the sibling oauth-demo-recorder project so this one works out of the box.
OPENAI_API_KEY=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Script writing + voice.
OPENAI_SCRIPT_MODEL=gpt-5.6-luna
# Every stage talks to the local gateway (./bin/llm-gateway), which answers
# chat from a subscription CLI and proxies speech and video on to OpenAI.
# Comment this out to go straight to OpenAI for everything.
OPENAI_BASE_URL=http://127.0.0.1:4000/v1
# Where the gateway proxies to. Never set this to OPENAI_BASE_URL — that is the
# gateway itself, and it refuses to start rather than proxy to its own port.
# OPENAI_UPSTREAM_BASE_URL=https://api.openai.com/v1
# OPENAI_GATEWAY_PORT=4000
# gpt-4o-mini-tts takes delivery direction, which is what lets each project act
# rather than just sound different. tts-1-hd still works and silently ignores it.
OPENAI_TTS_MODEL=gpt-4o-mini-tts
# The host's voice. Every project is cast against it: `video-studio voices`.
OPENAI_TTS_VOICE=ash

# Optional: raises the GitHub API rate limit. Left unset, the sources fall back to `gh auth token`.
# GITHUB_TOKEN=
