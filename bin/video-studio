#!/usr/bin/env bash
# Wrapper so `video-studio <command>` works from anywhere. Node >= 22.6 strips
# the TypeScript types itself, so there's no build step.
set -e
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
exec node --experimental-strip-types --no-warnings "$SCRIPT_DIR/../src/cli.ts" "$@"
